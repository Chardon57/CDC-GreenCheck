# Base de données MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ECHO=False

# Environnement applicatif
APP_ENV=development
APP_PORT=8000

# JWT (authentification)
JWT_SECRET_KEY=clé_a_generer
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Pl@ntNet API Key
PLANTNET_API_KEY=clé_API_Pl@ntNet
PLANTNET_BASE_URL=https://my-api.plantnet.org
PLANTNET_TIMEOUT=10 # Délai maximal (en secondes) accordé à Pl@ntNet pour répondre.
PLANTNET_MIN_SCORE=0.5 # Score minimal (0 à 1) pour accepter une identification, valeur à calibrer avec de vraies photos (plantes nettes, photos floues, objets non végétaux).

# Moteur IA de diagnostic (conteneur ai_engine)
ENGINE_URL=http://localhost:8001
ENGINE_TIMEOUT=30 # Délai maximal (en secondes) accordé au moteur pour répondre.

# Photos des utilisateurs
UPLOADS_DIR=uploads # Dossier de stockage (relatif à backend/ ou chemin absolu) : <UPLOADS_DIR>/<id_user>/<id_analysis>.jpg
MAX_UPLOAD_MB=10 # Taille maximale d'une photo envoyée, en Mo.
