# URL de l'API backend (préfixe VITE_ obligatoire pour être exposé au navigateur)
VITE_API_URL=http://localhost:8000

# Environnement
VITE_APP_ENV=development

# Mode démo : true = données fictives sans backend (connexion : jp.glad@example.com / test1234)
#             false (ou absent) = vraie API. Redémarrer `pnpm dev` après modification.
VITE_USE_MOCK=false
